# REQUIRED in production
SECRET_KEY=generate-a-long-random-secret
FLASK_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

BUSINESS_START_DATE=2026-09-16
EMAIL_PUBLIC_AFTER_DAYS=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-unique-admin-password

# Render Free blocks outbound SMTP ports 25/465/587.
# Prefer an HTTPS mail API such as Resend for Render.
RESEND_API_KEY=
RESEND_FROM=

# SMTP is useful on hosts that permit it, but not Render Free.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=redgroup@gmail.com

SHOW_DEV_EMAIL_LINK=false
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
